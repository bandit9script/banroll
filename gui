-- Кэш объектов карты для Wallbang
local MAP_IgnoreList = nil

local function CollectMapObjects()
    local mapFolder = workspace:FindFirstChild("MAP")
    if not mapFolder then
        mapFolder = workspace
    end
    local objects = {}
    local function recurse(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("BasePart") and child.CanCollide then
                table.insert(objects, child)
            end
            recurse(child)
        end
    end
    recurse(mapFolder)
    return objects
end

local function getWallbangIgnoreList(originalIgnoreList)
    if not MAP_IgnoreList then
        MAP_IgnoreList = CollectMapObjects()
    end
    local newList = {}
    if originalIgnoreList and type(originalIgnoreList) == "table" then
        for _, obj in ipairs(originalIgnoreList) do
            table.insert(newList, obj)
        end
    end
    for _, obj in ipairs(MAP_IgnoreList) do
        table.insert(newList, obj)
    end
    return newList
end

function CalculateChance(Percentage)
    Percentage = math.floor(Percentage)
    local chance = math.floor(Random.new().NextNumber(Random.new(), 0, 1) * 100) / 100
    return chance <= Percentage / 100
end

