-- Хук с Wallbang и обходом детекта
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method = getnamecallmethod()
    local Arguments = {...}
    local self = Arguments[1]

    if not Toggles.aim_Enabled.Value or checkcaller() then
        return oldNamecall(...)
    end
    if self ~= workspace then
        return oldNamecall(...)
    end

    if Method == "FindPartOnRayWithIgnoreList" or Method == "Raycast" then
        local HitPart = getClosestPlayer()
        if HitPart then
            if not CalculateChance(SilentAimSettings.HitChance) then
                return oldNamecall(...)
            end

            local Origin, Direction
            if Method == "FindPartOnRayWithIgnoreList" then
                Origin = Arguments[2].Origin
            else
                Origin = Arguments[2]
            end
            Direction = getDirection(Origin, HitPart.Position)

            if Method == "FindPartOnRayWithIgnoreList" then
                Arguments[2] = Ray.new(Origin, Direction)
                if SilentAimSettings.Wallbang then
                    Arguments[3] = getWallbangIgnoreList(Arguments[3])
                end
            else
                Arguments[3] = Direction
            end

            return oldNamecall(unpack(Arguments))
        end
    end

    return oldNamecall(...)
end))
