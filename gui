-- Wallbang логгер объектов
local MAP_IgnoreList = nil
local lastMapUpdate = 0

local function UpdateMapIgnoreList()
    local mapFolder = workspace:FindFirstChild("MAP") or workspace
    local objects = {}
    for _, obj in ipairs(mapFolder:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CanCollide then
            table.insert(objects, obj)
        end
    end
    MAP_IgnoreList = objects
    lastMapUpdate = tick()
end

local function getWallbangIgnoreList(originalIgnoreList)
    if not MAP_IgnoreList or tick() - lastMapUpdate > 5 then
        UpdateMapIgnoreList()
    end
    local newList = {}
    if type(originalIgnoreList) == "table" then
        for _, obj in ipairs(originalIgnoreList) do
            table.insert(newList, obj)
        end
    end
    for _, obj in ipairs(MAP_IgnoreList) do
        table.insert(newList, obj)
    end
    return newList
end

function CalculateChance(Percentage)
    Percentage = math.floor(Percentage)
    local chance = math.floor(Random.new().NextNumber(Random.new(), 0, 1) * 100) / 100
    return chance <= Percentage / 100
end

local function getPositionOnScreen(Vector)
    local Vec3, OnScreen = WorldToScreen(Camera, Vector)
    return Vector2.new(Vec3.X, Vec3.Y), OnScreen
end

local function getDirection(Origin, Position)
    return (Position - Origin).Unit * 1000
end

local function getMousePosition()
    return GetMouseLocation(UserInputService)
end

local function IsPlayerVisible(Player)
    local PlayerCharacter = Player.Character
    local LocalPlayerCharacter = LocalPlayer.Character
    if not (PlayerCharacter or LocalPlayerCharacter) then return false end 
    local PlayerRoot = FindFirstChild(PlayerCharacter, Options.TargetPart.Value) or FindFirstChild(PlayerCharacter, "HumanoidRootPart")
    if not PlayerRoot then return false end 
    local CastPoints = {PlayerRoot.Position, LocalPlayerCharacter, PlayerCharacter}
    local IgnoreList = {LocalPlayerCharacter, PlayerCharacter}
    return #GetPartsObscuringTarget(Camera, CastPoints, IgnoreList) == 0
end

local function getClosestPlayer()
    if not Options.TargetPart.Value then return nil end
    local Closest = nil
    local DistanceToMouse = nil
    local TargetPartValue = Options.TargetPart.Value
    local maxDist = SilentAimSettings.MaxDistance
    local wallbangActive = SilentAimSettings.Wallbang

    for _, Player in next, GetPlayers(Players) do
        if Player == LocalPlayer then continue end
        if Toggles.TeamCheck.Value and Player.Team == LocalPlayer.Team then continue end

        local Character = Player.Character
        if not Character then continue end

        local Humanoid = FindFirstChild(Character, "Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then continue end

        local AimPart
        if TargetPartValue == "Random" then
            AimPart = Character[ValidTargetParts[math.random(1, #ValidTargetParts)]]
        else
            AimPart = Character[TargetPartValue]
        end
        if not AimPart then
            AimPart = Character:FindFirstChild("HumanoidRootPart")
            if not AimPart then continue end
        end

        if not wallbangActive and Toggles.VisibleCheck.Value then
            if not IsPlayerVisible(Player) then continue end
        end

        if maxDist < 1000 then
            local myChar = LocalPlayer.Character
            local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Camera.CFrame.Position
            if (AimPart.Position - myPos).Magnitude > maxDist then continue end
        end

        local ScreenPosition, OnScreen = getPositionOnScreen(AimPart.Position)
        if not OnScreen then continue end

        local Distance = (getMousePosition() - ScreenPosition).Magnitude
        if Distance <= (DistanceToMouse or Options.Radius.Value or 2000) then
            Closest = AimPart
            DistanceToMouse = Distance
        end
    end
    return Closest
end

-- Функция проверки прострела (Auto Wall)
local function CanShootThrough(targetPart)
    local Origin = Camera.CFrame.Position
    local Direction = (targetPart.Position - Origin).Unit * 1000
    local Raycast = Ray.new(Origin, Direction)

    local ignoreList = {LocalPlayer.Character, targetPart.Parent}
    local Hit, _ = workspace:FindPartOnRayWithIgnoreList(Raycast, ignoreList, false, true)

    if Hit and (Hit:IsDescendantOf(targetPart.Parent) or Hit.CanCollide) then
        return true
    end
    return false
end

