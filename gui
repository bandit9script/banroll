local ESP_Cache = {}
local function CreateESP(player)
    local draw = {Box = Drawing.new("Square"), Fill = Drawing.new("Square"), HP_Segments = {}}
    draw.Box.Filled = false; draw.Box.ZIndex = 2
    draw.Fill.Filled = true; draw.Fill.ZIndex = 1
    for i = 1, 10 do
        local seg = Drawing.new("Square"); seg.Filled = true; seg.ZIndex = 3
        draw.HP_Segments[i] = seg
    end
    return draw
end

resume(create(function()
    RenderStepped:Connect(function()
        -- Обновляем кэш цели
        if Toggles.aim_Enabled.Value then
            cachedTarget = getClosestPlayer()
        else
            cachedTarget = nil
        end

        -- ОБРАБОТКА FOV С ИДЕАЛЬНО КРУГЛОЙ ЗАЛИВКОЙ
        if Toggles.Visible.Value then 
            local mousePos = getMousePosition()
            local baseRadius = Options.Radius.Value
            
            local c1 = Options.Color1.Value
            local c2 = Options.Color2.Value
            
            local f1 = Options.FillColor1.Value
            local f2 = Options.FillColor2.Value
            
            local time = tick()
            local pulse = SilentAimSettings.FOVPulsate and (math.sin(time * 4.5) * 7) or 0
            local currentRadius = baseRadius + pulse
            
            local colorLerp = (math.sin(time * 2.5) + 1) / 2
            local currentMainColor = c1:Lerp(c2, colorLerp)
            
            fov_outline.Radius = currentRadius
            fov_outline.Position = mousePos
            fov_outline.Color = currentMainColor
            fov_outline.Transparency = 0.9
            fov_outline.Visible = true
            
            if Toggles.FOVFilled.Value then
                FovContainer.Visible = true
                local diameter = currentRadius * 2
                FovContainer.Size = UDim2.new(0, diameter, 0, diameter)
                FovContainer.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y - 58)
                FovFillFrame.Size = UDim2.new(1, 0, 1, 0)
                FovFillFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
                UIGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, f1),
                    ColorSequenceKeypoint.new(0.5, f1:Lerp(f2, 0.5)),
                    ColorSequenceKeypoint.new(1, f2)
                })
                UIGradient.Rotation = (time * 150) % 360 
            else
                FovContainer.Visible = false
            end
            
            if SilentAimSettings.FOVGlow then
                local glowPulse = 4 + (math.sin(time * 6) * 2)
                fov_glow.Radius = currentRadius
                fov_glow.Position = mousePos
                fov_glow.Thickness = glowPulse
                fov_glow.Color = currentMainColor
                fov_glow.Transparency = 0.35 + (math.sin(time * 6) * 0.1)
                fov_glow.Visible = true
            else
                fov_glow.Visible = false
            end
        else
            fov_outline.Visible = false
            fov_glow.Visible = false
            FovContainer.Visible = false
        end

        -- ТРЕТЬЕ ЛИЦО
        if SilentAimSettings.ThirdPerson then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = SilentAimSettings.ThirdPersonDistance
            LocalPlayer.CameraMinZoomDistance = SilentAimSettings.ThirdPersonDistance
            if (Camera.CoordinateFrame.p - Camera.Focus.p).Magnitude < (SilentAimSettings.ThirdPersonDistance - 1) then
                LocalPlayer.CameraMaxZoomDistance = SilentAimSettings.ThirdPersonDistance
            end
        end

        -- ТЕЛЕПОРТ ВРАГОВ
        if SilentAimSettings.TPEnemies then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local forwardDist = Options.TPOffsetForward and Options.TPOffsetForward.Value or 7
                local upDist = Options.TPOffsetHeight and Options.TPOffsetHeight.Value or 6
                local targetPoint = myRoot.Position + (myRoot.CFrame.LookVector * forwardDist) + (myRoot.CFrame.UpVector * upDist)

                for _, player in next, GetPlayers(Players) do
                    if player == LocalPlayer or (Toggles.TeamCheck.Value and player.Team == LocalPlayer.Team) then continue end
                    local enemyChar = player.Character
                    local enemyRoot = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
                    local enemyHum = enemyChar and enemyChar:FindFirstChild("Humanoid")
                    if enemyRoot and enemyHum and enemyHum.Health > 0 then
                        enemyRoot.Velocity = Vector3.new(0, 0, 0)
                        enemyRoot.CFrame = CFrame.new(targetPoint)
                    end
                end
            end
        end

        -- АВТО ОГОНЬ С ПРОВЕРКОЙ ПРОСТРЕЛА
        if AutoFireEnabled and cachedTarget then
            local targetHum = cachedTarget.Parent and cachedTarget.Parent:FindFirstChild("Humanoid")
            if targetHum and targetHum.Health > 0 then
                local canShoot = true
                if AutoWallEnabled then
                    canShoot = CanShootThrough(cachedTarget)
                end
                if canShoot then
                    local now = tick() * 1000
                    if now - lastShotTime >= ShootDelay then
                        -- Эмуляция клика левой кнопкой мыши
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        lastShotTime = now
                    end
                end
            end
        end

        -- ESP
        if Toggles.esp_Enabled and Toggles.esp_Enabled.Value then
            for _, player in next, GetPlayers(Players) do
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or player == LocalPlayer or (Toggles.TeamCheck.Value and player.Team == LocalPlayer.Team) then
                    if ESP_Cache[player] then
                        ESP_Cache[player].Box.Visible = false; ESP_Cache[player].Fill.Visible = false
                        for _, seg in next, ESP_Cache[player].HP_Segments do seg.Visible = false end
                    end
                    continue
                end
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChild("Humanoid")
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if not onScreen then
                    if ESP_Cache[player] then
                        ESP_Cache[player].Box.Visible = false; ESP_Cache[player].Fill.Visible = false
                        for _, seg in next, ESP_Cache[player].HP_Segments do seg.Visible = false end
                    end
                    continue
                end
                if not ESP_Cache[player] then ESP_Cache[player] = CreateESP(player) end
                local d = ESP_Cache[player]
                local head = Camera:WorldToViewportPoint(char.Head.Position + Vector3.new(0, 0.5, 0))
                local foot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                local height = math.abs(head.Y - foot.Y)
                local width = height / 2
                local x = pos.X - width / 2
                local y = head.Y
                d.Box.Size = Vector2.new(width, height); d.Box.Position = Vector2.new(x, y)
                d.Box.Visible = Toggles.esp_Box.Value; d.Box.Thickness = Options.esp_Thickness.Value
                d.Box.Color = Options.esp_BoxColor.Value
                d.Fill.Size = Vector2.new(width, height); d.Fill.Position = Vector2.new(x, y)
                d.Fill.Visible = Toggles.esp_Fill.Value; d.Fill.Transparency = Options.esp_FillTransparency.Value
                d.Fill.Color = Options.esp_FillColor.Value
                local hp = hum and math.clamp(hum.Health / hum.MaxHealth, 0, 1) or 1
                local activeSegments = math.floor(hp * 10)
                local lowCol = Options.esp_LowHP.Value
                local highCol = Options.esp_HighHP.Value
                local midCol = lowCol:Lerp(highCol, 0.5)
                for i = 1, 10 do
                    local seg = d.HP_Segments[i]
                    local segHeight = height / 10
                    seg.Size = Vector2.new(4, segHeight - 1)
                    seg.Position = Vector2.new(x - 8, (y + height) - (segHeight * i))
                    seg.Visible = (i <= activeSegments) and Toggles.esp_Health.Value
                    if seg.Visible then
                        if i <= 5 then seg.Color = lowCol:Lerp(midCol, (i - 1) / 4) else seg.Color = midCol:Lerp(highCol, (i - 5) / 5) end
                    end
                end
            end
        else
            for _, d in next, ESP_Cache do
                d.Box.Visible = false; d.Fill.Visible = false
                for _, seg in next, d.HP_Segments do seg.Visible = false end
            end
        end
    end)
end))

-- Сайлент Хук (оригинальный)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method = getnamecallmethod()
    local Arguments = {...}
    local self = Arguments[1]
    if not Toggles.aim_Enabled.Value or checkcaller() or self ~= workspace then return oldNamecall(...) end

    if Method == "FindPartOnRayWithIgnoreList" or Method == "Raycast" then
        local HitPart = getClosestPlayer()
        if HitPart then
            if not CalculateChance(SilentAimSettings.HitChance) then return oldNamecall(...) end
            local Origin, Direction
            if Method == "FindPartOnRayWithIgnoreList" then Origin = Arguments[2].Origin else Origin = Arguments[2] end
            Direction = getDirection(Origin, HitPart.Position)
            if Method == "FindPartOnRayWithIgnoreList" then
                Arguments[2] = Ray.new(Origin, Direction)
                if SilentAimSettings.Wallbang then
                    local oldIgnore = Arguments[3]
                    if type(oldIgnore) ~= "table" then oldIgnore = {} end
                    Arguments[3] = getWallbangIgnoreList(oldIgnore)
                end
            else
                Arguments[3] = Direction
            end
            return oldNamecall(unpack(Arguments))
        end
    end
    return oldNamecall(...)
end))
